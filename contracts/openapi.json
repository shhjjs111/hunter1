  "info": {
    "description": "求职工作台 —— 本地优先，前后端完全分离",
    "title": "Hunter1",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/applications": {
      "get": {
        "operationId": "list_applications_api_applications_get",
        "responses": {
          "200": {
            "content": {
