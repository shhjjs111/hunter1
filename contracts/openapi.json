            "title": "Total Created",
            "type": "integer"
          },
          "total_fetched": {
            "title": "Total Fetched",
            "type": "integer"
          }
        },
        "required": [
          "running",
          "sites",
          "total_fetched",
          "total_created"
        ],
        "title": "CrawlStatusResponse",
        "type": "object"
      },
      "CreateApplicationRequest": {
        "description": "记录一次投递的请求体。\n\n`job_id` 支持全 id 或唯一前缀（与岗位详情端点同一套解析）—— 助手常只看到\n前 8 位 id，界面给的是全 id，两者都得能用。",
